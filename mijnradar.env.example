# Instellingen voor mijnradar. Kopieer naar /etc/mijnradar/mijnradar.env
# en vul in. Het echte bestand staat alleen op de server, nooit op GitHub.

# Sleutel voor de Open Data API (neerslagradar, HDF5-bestanden).
KNMI_API_KEY=

# Sleutel voor de kaartdienst WMS/WCS (zonlaag, satellietbeelden). Dit is een
# andere sleutel dan hierboven: beide zijn los aan te vragen in de API Catalog
# van het KNMI Developer Portal. Blijft dit leeg, dan draait de zonlaag niet
# mee en verandert er verder niets.
KNMI_WMS_API_KEY=

# Sleutel voor de basiskaart van CARTO (de rastertegels onder de radarbeelden).
# CARTO vraagt die sinds augustus 2026; zonder sleutel komt er een watermerk
# "API KEY REQUIRED" over de kaart. De kaart blijft verder gewoon werken.
# Aan te vragen op het CARTO-account zelf, niet via een link in een e-mail.
CARTO_KEY=

# ── Weeralert ────────────────────────────────────────────────────────────
# Meldt zodra de 2-uursvoorspelling neerslag toont binnen de straal rond
# het ingestelde punt. Er zijn twee kanalen: mail en MQTT. Elk kanaal staat
# aan zodra de instellingen ervan gevuld zijn, en uit zodra ze leeg zijn.
# Zijn beide kanalen leeg, dan gebeurt er niets.

# Straal in km rond het punt (standaard 10).
ALERT_STRAAL_KM=10

# Drempel in mm/uur; neerslag daaronder telt niet mee (standaard 1).
ALERT_DREMPEL_MM_UUR=1

# Wachttijd in uren na een verstuurde melding (standaard 6). Geldt voor beide
# kanalen samen: mail en telefoonmelding gaan gelijk op.
ALERT_WACHT_UUR=6

# Het punt waarop wordt gecontroleerd (standaard Haarlem).
ALERT_LAT=52.387
ALERT_LON=4.646
ALERT_PLAATS=Haarlem

# ── Kanaal 1: mail ───────────────────────────────────────────────────────
# Staat aan zodra ALERT_NAAR en SMTP_HOST allebei gevuld zijn.

# Een of meer ontvangers, gescheiden door komma's.
ALERT_NAAR=

# SMTP voor het versturen (bijvoorbeeld Gmail met een app-wachtwoord).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_VAN=
MAIL_NAAM=MijnRadar

# ── Kanaal 2: MQTT ───────────────────────────────────────────────────────
# Zet de melding als JSON op de broker. Home Assistant luistert op het
# onderwerp en maakt er een telefoonmelding van. Staat aan zodra MQTT_HOST en
# MQTT_TOPIC allebei gevuld zijn. Het account is eigen aan mijnradar, volgens
# de afspraak dat elke dienst een eigen account op de broker krijgt.

MQTT_HOST=192.168.2.38
MQTT_PORT=1883
MQTT_TOPIC=mijnradar/neerslag
MQTT_USER=mijnradar
MQTT_PASSWORD=
MQTT_CLIENT_ID=mijnradar-alert
