# Instellingen voor mijnradar. Kopieer naar /etc/mijnradar/mijnradar.env
# en vul in. Het echte bestand staat alleen op de server, nooit op GitHub.

# Sleutel voor de Open Data API (neerslagradar, HDF5-bestanden).
KNMI_API_KEY=

# Sleutel voor de kaartdienst WMS/WCS (zonlaag, satellietbeelden). Dit is een
# andere sleutel dan hierboven: beide zijn los aan te vragen in de API Catalog
# van het KNMI Developer Portal. Blijft dit leeg, dan draait de zonlaag niet
# mee en verandert er verder niets.
KNMI_WMS_API_KEY=

# ── Weeralert ────────────────────────────────────────────────────────────
# Mailt zodra de 2-uursvoorspelling neerslag toont binnen de straal rond
# het ingestelde punt. Leeg laten van ALERT_NAAR of SMTP_HOST zet het
# alert uit.

# Een of meer ontvangers, gescheiden door komma's.
ALERT_NAAR=

# Straal in km rond het punt (standaard 10).
ALERT_STRAAL_KM=10

# Drempel in mm/uur; neerslag daaronder telt niet mee (standaard 1).
ALERT_DREMPEL_MM_UUR=1

# Wachttijd in uren na een verzonden alert (standaard 6).
ALERT_WACHT_UUR=6

# Het punt waarop wordt gecontroleerd (standaard Haarlem).
ALERT_LAT=52.387
ALERT_LON=4.646
ALERT_PLAATS=Haarlem

# SMTP voor het versturen (bijvoorbeeld Gmail met een app-wachtwoord).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_VAN=
MAIL_NAAM=MijnRadar
